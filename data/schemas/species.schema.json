{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PALEOSPHERE 종 정의",
  "description": "data/species/*.json. 항목 묶음마다 evidence(근거 수준)를 반드시 적는다. 속도·생리·생활사 수치는 게임 내 시간 기준의 가정이다.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "scientific_name",
    "name",
    "diet",
    "period",
    "range",
    "body",
    "locomotion",
    "physiology",
    "life_history"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,64}$"
    },
    "scientific_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "name": {
      "type": "object",
      "required": [
        "ko"
      ],
      "properties": {
        "ko": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "en": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "diet": {
      "enum": [
        "herbivore",
        "carnivore",
        "omnivore"
      ]
    },
    "period": {
      "type": "object",
      "required": [
        "text",
        "evidence"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "evidence": {
          "enum": [
            "confirmed",
            "inferred",
            "simplified"
          ],
          "description": "confirmed = 화석으로 확인, inferred = 학술적 추정, simplified = 게임적 단순화"
        }
      }
    },
    "range": {
      "type": "object",
      "required": [
        "text",
        "evidence"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "evidence": {
          "enum": [
            "confirmed",
            "inferred",
            "simplified"
          ],
          "description": "confirmed = 화석으로 확인, inferred = 학술적 추정, simplified = 게임적 단순화"
        }
      }
    },
    "body": {
      "type": "object",
      "required": [
        "evidence",
        "length_m",
        "mass_kg"
      ],
      "properties": {
        "evidence": {
          "enum": [
            "confirmed",
            "inferred",
            "simplified"
          ],
          "description": "confirmed = 화석으로 확인, inferred = 학술적 추정, simplified = 게임적 단순화"
        },
        "length_m": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 60
        },
        "mass_kg": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 150000
        },
        "note": {
          "type": "string"
        }
      }
    },
    "locomotion": {
      "type": "object",
      "required": [
        "evidence",
        "walk_speed_mps",
        "run_speed_mps"
      ],
      "properties": {
        "evidence": {
          "enum": [
            "confirmed",
            "inferred",
            "simplified"
          ],
          "description": "confirmed = 화석으로 확인, inferred = 학술적 추정, simplified = 게임적 단순화"
        },
        "walk_speed_mps": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 30
        },
        "run_speed_mps": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 40
        },
        "turn_rate_deg_per_sec": {
          "type": "number",
          "minimum": 5,
          "maximum": 720
        },
        "perception_radius_m": {
          "type": "number",
          "minimum": 5,
          "maximum": 300
        }
      }
    },
    "physiology": {
      "type": "object",
      "required": [
        "evidence",
        "daily_food_kg",
        "energy_reserve_days",
        "intake_kg_per_hour",
        "hydration_reserve_days",
        "drink_hours_to_full",
        "awake_hours",
        "rest_hours",
        "starve_health_days",
        "dehydration_health_days",
        "health_regen_per_day"
      ],
      "properties": {
        "evidence": {
          "enum": [
            "confirmed",
            "inferred",
            "simplified"
          ],
          "description": "confirmed = 화석으로 확인, inferred = 학술적 추정, simplified = 게임적 단순화"
        },
        "daily_food_kg": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 5000
        },
        "energy_reserve_days": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 200
        },
        "intake_kg_per_hour": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 2000
        },
        "hydration_reserve_days": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 100
        },
        "drink_hours_to_full": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 24
        },
        "awake_hours": {
          "type": "number",
          "minimum": 1,
          "maximum": 200
        },
        "rest_hours": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 100
        },
        "starve_health_days": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 100
        },
        "dehydration_health_days": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 100
        },
        "health_regen_per_day": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "life_history": {
      "type": "object",
      "required": [
        "evidence",
        "adult_age_days",
        "max_age_days"
      ],
      "properties": {
        "evidence": {
          "enum": [
            "confirmed",
            "inferred",
            "simplified"
          ],
          "description": "confirmed = 화석으로 확인, inferred = 학술적 추정, simplified = 게임적 단순화"
        },
        "adult_age_days": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "max_age_days": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "placement": {
      "type": "object",
      "properties": {
        "biomes": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,64}$"
          }
        }
      }
    },
    "proxy": {
      "type": "object",
      "required": [
        "evidence"
      ],
      "properties": {
        "evidence": {
          "enum": [
            "confirmed",
            "inferred",
            "simplified"
          ],
          "description": "confirmed = 화석으로 확인, inferred = 학술적 추정, simplified = 게임적 단순화"
        },
        "shape": {
          "type": "string",
          "maxLength": 32
        },
        "color": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "topic",
          "text",
          "evidence"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "maxLength": 80
          },
          "text": {
            "type": "string",
            "maxLength": 600
          },
          "evidence": {
            "enum": [
              "confirmed",
              "inferred",
              "simplified"
            ],
            "description": "confirmed = 화석으로 확인, inferred = 학술적 추정, simplified = 게임적 단순화"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 300
          },
          "note": {
            "type": "string",
            "maxLength": 600
          }
        }
      }
    },
    "model": {
      "type": "object",
      "description": "3D 모델(선택). 표현 계층만 쓴다. 없거나 불러오지 못하면 코드로 만든 메시를 쓴다.",
      "required": [
        "evidence",
        "path",
        "source",
        "license",
        "length_units",
        "walk_units_per_second",
        "run_units_per_second",
        "animations"
      ],
      "properties": {
        "evidence": {
          "enum": [
            "confirmed",
            "inferred",
            "simplified"
          ],
          "description": "confirmed = 화석으로 확인, inferred = 학술적 추정, simplified = 게임적 단순화"
        },
        "path": {
          "type": "string",
          "pattern": "^res://assets/[^\\\\]*\\.(fbx|glb|gltf|tscn|scn)$",
          "maxLength": 200
        },
        "source": {
          "type": "string",
          "maxLength": 300
        },
        "license": {
          "type": "string",
          "maxLength": 100
        },
        "length_units": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 100000,
          "description": "모델의 머리끝–꼬리끝 길이(모델 단위). tools/godot/measure_model.gd로 잰다"
        },
        "walk_units_per_second": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 100000,
          "description": "걷기 애니메이션 1배속에서 발이 미끄러지지 않는 속도. tools/godot/measure_gait.gd로 잰다"
        },
        "run_units_per_second": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 100000
        },
        "animations": {
          "type": "object",
          "required": [
            "idle",
            "walk",
            "run"
          ],
          "properties": {
            "idle": {
              "type": "string",
              "maxLength": 100
            },
            "walk": {
              "type": "string",
              "maxLength": 100
            },
            "run": {
              "type": "string",
              "maxLength": 100
            },
            "death": {
              "type": "string",
              "maxLength": 100
            },
            "attack": {
              "type": "string",
              "maxLength": 100
            }
          },
          "additionalProperties": false
        }
      }
    },
    "predation": {
      "type": "object",
      "description": "포식 관계(선택). 수치는 게임적 단순화.",
      "required": [
        "evidence"
      ],
      "properties": {
        "evidence": {
          "enum": [
            "confirmed",
            "inferred",
            "simplified"
          ],
          "description": "confirmed = 화석으로 확인, inferred = 학술적 추정, simplified = 게임적 단순화"
        },
        "attack_success": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "공격 한 번의 기본 성공 확률. 0이면 사냥하지 않는다. 초식동물은 0이어야 한다"
        },
        "defense": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "공격받을 때 버티고 반격하는 정도"
        },
        "max_chase_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 600
        },
        "smell_radius_m": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        }
      }
    }
  }
}
